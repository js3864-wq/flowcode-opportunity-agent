# Required for live runs. Without it the app and CLI fall back to replaying saved reports.
ANTHROPIC_API_KEY=

# Optional model overrides (defaults shown)
AGENT_MODEL_RESEARCH=claude-sonnet-5-5
AGENT_MODEL_SYNTHESIS=claude-opus-5-5
AGENT_MODEL_FAST=claude-haiku-5-5

# Optional: searches allowed per research lens (default 5)
AGENT_MAX_SEARCHES_PER_LENS=5
