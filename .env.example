# Required for live runs. Without it the app and CLI replay saved reports instead.
ANTHROPIC_API_KEY=

# Cost profile: lite (default, Haiku reads, Sonnet writes, 3 searches per lens)
# or full (Sonnet reads, Opus writes, 5 searches per lens, about $2 per company).
AGENT_PROFILE=lite

# Hard spending cap per company in USD. The run stops before the next model call once
# its estimated spend passes this. Defaults: 0.75 for lite, 3.00 for full.
AGENT_MAX_COST_USD=

# Optional overrides
AGENT_MODEL_RESEARCH=
AGENT_MODEL_SYNTHESIS=
AGENT_MODEL_FAST=
AGENT_MAX_SEARCHES_PER_LENS=
